# Python caches and local environments
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.cache/

# Notebook autosave checkpoints (keep the actual notebooks)
.ipynb_checkpoints/

# Local environment variables (keep example templates)
.env
.env.*
!.env.example
!.env.*.example

# Optional local JavaScript tooling
node_modules/

# Editor state; keep shared formatting and extension settings
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*.swo
*~

# OS metadata and runtime logs
.DS_Store
Thumbs.db
Desktop.ini
*.log

# Keep index.html, .nojekyll, and pages/ (assets, partials, project pages) tracked.
# GitHub Pages publishes those files directly.
